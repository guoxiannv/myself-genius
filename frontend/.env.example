# Optional local overrides (loaded after deploy/server.env).
#
# Setup:
#   1. cp deploy/server.env.example deploy/server.env
#   2. cp deploy/profile-pool.example.json deploy/profile-pool.json
#   3. Put .cer / .p7b / .p12 under deploy/signing/
#   4. Fill deploy/server.env (passwords, tunnel token, machine paths)
#
# Uncomment to override on this machine only:
# HP_HDC_TARGET=127.0.0.1:5555
