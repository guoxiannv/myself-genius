# Server runtime config for Genius/frontend.
#
# Setup:
#   cp deploy/server.env.example deploy/server.env
#   # edit deploy/server.env — this file is gitignored
#
# Profile pool (bundleName read from each .p7b):
#   cp deploy/profile-pool.example.json deploy/profile-pool.json
#   # copy signing files into deploy/signing/

# Keep the version2 stack isolated from bitfun-platform.com on 8080/8081.
PORT=8089
BACKEND_PORT=8090
HOST=127.0.0.1
TMUX_SESSION=remote-ui-dev2

# Optional single Root administrator. Generate both values with:
#   python3 scripts/generate_root_auth_config.py
# Do not commit the real values to source control.
HP_ROOT_PASSWORD_HASH=
HP_AUTH_SIGNING_SECRET=

# harmony-pilot tmux-runner
HP_TMUX_RUNNER=../../devkit_studio/scripts/tmux-runner.cjs
HP_TARGET_WORKSPACE=workspace
HP_TMUX_VARIANT=autopilot-html-tmux-team-split
# OPENBITFUN_PROXY_ROOT=/absolute/path/to/Genius/frontend
OPENBITFUN_PROXY_COMMAND='node scripts/openbitfun-usage-proxy.mjs'
# When Claude Code should use this local proxy, configure its base URL here.
# Keep API credentials in the user-level Claude settings or another secret store.
# ANTHROPIC_BASE_URL=http://127.0.0.1:40363
# OPENBITFUN_PROXY_PORT=40363
# OPENBITFUN_PROXY_SSE_BUFFER_MAX_BYTES=16777216
# OPENBITFUN_AUTH_TOKEN=...
# ANTHROPIC_DEFAULT_OPUS_MODEL=k3-256k
# ANTHROPIC_DEFAULT_SONNET_MODEL=kimi-for-coding
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
# ZHIPU_AUTH_TOKEN=...
# ZHIPU_TARGET=https://open.bigmodel.cn/api/anthropic
# ZHIPU_OPUS_MODEL=glm-5.2
# ZHIPU_SONNET_MODEL=glm-5.2
# CSITOOL_AUTH_TOKEN=...
# CSITOOL_TARGET=http://127.0.0.1:8080/v1
# CSITOOL_ALLOW_INSECURE_HTTP=1
# CSITOOL_OPUS_MODEL=GLM-5.2
# CSITOOL_SONNET_MODEL=GLM-5.2
# CSITOOL_HAIKU_MODEL=Qwen3.7-Plus

# Expo Harmony Fast runtime in the Genius monorepo. Relative paths are resolved
# from frontend/. These are also the code defaults and may be omitted.
HP_EXPO_FAST_ROOT=../runner
HP_EXPO_FAST_APP_ROOT=../expo-app
# HP_EXPO_FAST_ENV_FILE=../runner/.env

# Harmony Go public preview gateway. Route the public origin to
# http://127.0.0.1:3353 in Cloudflare Tunnel.
HP_EXPO_PUBLIC_SERVE_ENABLED=1
HP_EXPO_PUBLIC_SERVE_HOST=127.0.0.1
HP_EXPO_PUBLIC_SERVE_PORT=3353
HP_EXPO_PUBLIC_ORIGIN=https://version2app.bitfun-platform.com/
# HP_EXPO_PUBLIC_SERVE_STATE_PATH=data/expo-publications.json

# Claude Code config inherited by tmux sessions. Use a writable path for
# sandboxed/local service runs so plugin startup can create its files.
CLAUDE_CONFIG_DIR=.claude

# Profile pool — auto-enabled when deploy/profile-pool.json exists
HP_PROFILE_POOL_ENABLED=auto
HP_PROFILE_POOL_CONFIG=deploy/profile-pool.json
HP_PROFILE_POOL_STATE=deploy/profile-pool-state.json
HP_PROFILE_POOL_ISOLATE_WORKSPACE=0

# DevEco / HPack toolchain
HDC_PATH=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains/hdc
HP_HDC_TARGET=
# Expo 双预览使用同一份 Bundle，但分别绑定 PC/手机模拟器。
HP_HDC_DESKTOP_TARGET=
HP_HDC_PHONE_TARGET=
# Optional shared preview pools. Each Expo task leases one desktop and one phone.
HP_HDC_DESKTOP_TARGETS=
HP_HDC_PHONE_TARGETS=
# Live preview ownership: explicit page leave plus a heartbeat timeout fallback.
HP_PREVIEW_IDLE_SECONDS=120
HP_PREVIEW_LEAVE_GRACE_SECONDS=3
HP_PREVIEW_MAX_SESSION_SECONDS=1800
# A live PC preview must either become interactive or release the device promptly.
HP_DESKTOP_PREVIEW_LAUNCH_TIMEOUT_SEC=120
HP_CAPTURE_PYTHON_BIN=.venv/bin/python3
HP_HPACK_ENABLED=1
HP_HPACK_BIN=.venv/bin/hpack
HP_HPACK_PYTHON_BIN=.venv/bin/python3
HP_DEVECO_JAVA_HOME=/Applications/DevEco-Studio.app/Contents/jbr/Contents/Home
HP_HVIGORW=/Applications/DevEco-Studio.app/Contents/tools/hvigor/bin/hvigorw

# Keystore passwords (cert/profile paths are in deploy/profile-pool.json)
HP_HPACK_ALIAS=your_key_alias
HP_HPACK_KEYSTORE_PASSWORD=
HP_HPACK_KEY_PASSWORD=

# Public install page (Cloudflare Tunnel -> 127.0.0.1:PORT)
HP_HPACK_BASE_URL=https://your-domain.com/static/hpack
HP_HPACK_DEPLOY_DOMAIN=your-domain.com
HP_HPACK_STATIC_ROOT=static/hpack
HP_HPACK_PRODUCT=default
HP_HPACK_APP_NAME=MyApplication
HP_HPACK_CHECK_URLS=0

# Install QR: 0 = HTTPS install page (system camera OK); 1 = store:// direct (needs enterprise scanner)
HP_INSTALL_QR_USE_STORE=0

# Cloudflare Zero Trust -> Networks -> Tunnels -> token
CLOUDFLARE_TUNNEL_TOKEN=
