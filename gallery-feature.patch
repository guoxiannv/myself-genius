+
+  const related = GALLERY_TEMPLATES.filter(
+    (t) => t.id !== template.id && t.category === template.category,
+  ).slice(0, 3)
+
+  return (
+    <div className="aurora-bg min-h-screen">
+      <TopBar
+        left={<BackLink />}
+        right={
+          <>
+            <AuthControl />
+            <Link
+              to="/runs"
+              className="inline-flex h-9 items-center rounded-full border border-border bg-surface/70 px-3.5 text-xs text-foreground transition-colors hover:border-accent/40 hover:text-accent-soft"
+            >
+              我的应用
+            </Link>
+          </>
+        }
+      />
+
+      <main className="relative z-10 mx-auto w-full max-w-6xl px-5 pb-20 pt-4 sm:px-8">
+        <nav className="flex items-center gap-2 text-xs text-subtle">
