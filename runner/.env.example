# Copy this file to .env and replace every example path for the current machine.
# The local .env is ignored by Git.

# Parent directory for generated applications. Relative --output-dir values are
# resolved under this directory.
EXPO_FAST_APP_ROOT="/absolute/path/to/expo-app"

# Node.js 22.13 or newer. Optional when a compatible node is already on PATH.
EXPO_FAST_NODE="/absolute/path/to/node"

# Local Expo Harmony devkit_sdk checkout.
EXPO_HARMONY_SDK_ROOT="/absolute/path/to/devkit_sdk"

# Optional acceleration only: one or more compatible node_modules caches,
# separated by ':' on macOS/Linux. Leave unset to install normally from npm.
# EXPO_FAST_MODULE_CACHE="/absolute/path/to/cache-project/node_modules"

# DevEco Studio application root.
DEVECO_PATH="/Applications/DevEco-Studio.app"

# Claude Code executable. It may also be just "claude" when available on PATH.
CLAUDE_BIN="/absolute/path/to/claude"

# Print live model/controller progress in the terminal or tmux pane.
EXPO_FAST_LIVE_CLAUDE="1"
