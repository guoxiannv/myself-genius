# Copy this file to .env for machine-only settings: paths, devices, and the
# build pool. Relative paths resolve from runner/, independent of the shell's
# current working directory.
#
# This is one of three configuration files, and the only one about this machine:
#
#   config/execution.json   models, effort, context windows, per-role timeouts
#   .local/llm.env          endpoint and credentials (copy from llm.env.example)
#   .env                    this file
#
# Do not set CLAUDE_CODE_MAX_CONTEXT_TOKENS or
# CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING here. They are per-model properties that
# config/execution.json owns and the orchestrator injects per role; declaring
# them here makes start-livetest refuse to run rather than let the two disagree.

# --- Generated applications ---------------------------------------------------

# Parent directory for generated applications. Relative --output-dir values are
# resolved under this directory.
EXPO_FAST_APP_ROOT="../expo-app"

# Optional identity for the generated app. Both are derived from the project
# when unset; set them only to pin a specific bundle or version.
# EXPO_FAST_BUNDLE_IDENTIFIER="com.example.myapp"
# EXPO_FAST_VERSION_CODE="1000000"

# --- Toolchain ----------------------------------------------------------------

# Node.js 22.13 or newer. Optional when a compatible node is already on PATH.
EXPO_FAST_NODE="/absolute/path/to/node"

# Genius Expo Harmony SDK submodule.
EXPO_HARMONY_SDK_ROOT="../sdk"

# Optional explicit pnpm binary used to bootstrap the SDK workspace during pool
# setup. Consulted only when the SDK's dependencies are missing; otherwise the
# resolution order is Corepack beside Node, Corepack on PATH, pnpm on PATH, and
# finally npm's on-demand runner.
# EXPO_HARMONY_PNPM_BIN="/absolute/path/to/pnpm"

# DevEco Studio application root. hdc and the OpenHarmony SDK are resolved
# under it unless HDC below overrides the binary.
DEVECO_PATH="/Applications/DevEco-Studio.app"

# Optional explicit hdc binary. Defaults to
# $DEVECO_PATH/Contents/sdk/default/openharmony/toolchains/hdc.
# HDC="/absolute/path/to/hdc"

# Optional acceleration only: one or more compatible node_modules caches,
# separated by ':' on macOS/Linux. Leave unset to install normally from npm.
# EXPO_FAST_MODULE_CACHE="/absolute/path/to/cache-project/node_modules"

# Optional explicit SVG rasterizer for the generated app icon: sips,
# rsvg-convert, or magick. Leave unset to auto-detect.
# EXPO_FAST_ICON_RASTERIZER="sips"

# --- HAP build pool -----------------------------------------------------------

# Per-run unsigned HAP build pool. Required, not optional: preview is on by
# default (--launch) and enabling preview forces the HAP build, so every default
# run goes through this pool. Initialize and prewarm it once per machine before
# the first run -- see "初始化 Expo HAP 构建池" in the repository root readme.md:
#   ./setup-harmony-pool.sh
# POOL_ROOT defaults to Genius/harmony-pool. POOL_SIZE is the number of physical
# slots (1-4); each slot is a complete materialized native build workspace, and
# the count also caps how many HAP builds run at once. The first-run disk
# precheck is N * 8 GiB + 20 GiB -- about 28 GiB for one slot, about 52 GiB for
# the default four. HAP_ENABLED is only consulted when preview is disabled
# (--no-launch); with preview enabled it is short-circuited and the HAP is always
# built. HAP_WAIT_SECONDS bounds the FIFO wait for a free slot.
EXPO_HARMONY_POOL_ROOT="../harmony-pool"
EXPO_HARMONY_POOL_SIZE="4"
EXPO_HARMONY_HAP_ENABLED="0"
EXPO_HARMONY_HAP_WAIT_SECONDS="3600"

# --- Preview devices ----------------------------------------------------------

# Required when more than one Harmony device is connected.
# EXPO_FAST_HDC_TARGET="127.0.0.1:5557"
# EXPO_FAST_HDC_DESKTOP_TARGET="127.0.0.1:5557"
# EXPO_FAST_HDC_PHONE_TARGET="127.0.0.1:5559"

# Comma-separated pools. A preview job atomically leases one desktop and one
# phone; when both pairs are busy, later jobs wait in FIFO order.
# EXPO_FAST_HDC_DESKTOP_TARGETS="127.0.0.1:5557,127.0.0.1:5561"
# EXPO_FAST_HDC_PHONE_TARGETS="127.0.0.1:5555,127.0.0.1:5559"

# Accepted aliases for the five settings above, used by shared frontend
# deployments. Each EXPO_FAST_ name wins when both are present. Prefer the
# EXPO_FAST_ names here and leave these unset.
# HDC_TARGET="127.0.0.1:5557"
# HP_HDC_TARGET="127.0.0.1:5557"
# HP_HDC_DESKTOP_TARGET="127.0.0.1:5557"
# HP_HDC_PHONE_TARGET="127.0.0.1:5559"
# HP_HDC_DESKTOP_TARGETS="127.0.0.1:5557,127.0.0.1:5561"
# HP_HDC_PHONE_TARGETS="127.0.0.1:5555,127.0.0.1:5559"

# Device lease bookkeeping. Defaults: the path below, 90s lease, 60s quarantine
# after a failure, and a 3600s wait for a free device.
# EXPO_FAST_DEVICE_POOL_ROOT="/private/tmp/genius-expo-preview-pool"
# EXPO_FAST_PREVIEW_LEASE_SECONDS="90"
# EXPO_FAST_PREVIEW_QUARANTINE_SECONDS="60"
# EXPO_FAST_PREVIEW_WAIT_SECONDS="3600"

# Legacy Harmony Go diagnostic; direct-HAP preview ignores it.
# EXPO_FAST_PREVIEW_GATEWAY_ORIGIN="http://127.0.0.1:3456"

# Optional Harmony Go shell override. When a HAP is supplied, Runner reads its
# embedded module.json bundleName automatically before install/start/QA.
# EXPO_HARMONY_GO_HAP="/absolute/path/to/entry-default.hap"
# Explicit bundle override wins over HAP metadata. Normally leave this unset;
# the current SDK fallback is com.example.myapplication1.ide.
# EXPO_HARMONY_GO_BUNDLE_NAME="com.example.myapplication1.ide"

# --- Claude Code --------------------------------------------------------------

# The executable the orchestrator launches for every model turn. Point it at
# .local/claude-isolated to keep Claude Code state, credentials, and endpoint
# inside this repository instead of the developer's own setup.
CLAUDE_BIN=".local/claude-isolated"

# The real Claude Code executable that .local/claude-isolated then runs.
# Optional while claude is on PATH.
# GENIUS_CLAUDE_REAL_BIN="/absolute/path/to/claude"

# Print live model/controller progress in the terminal or tmux pane.
EXPO_FAST_LIVE_CLAUDE="1"

# --- Meta ---------------------------------------------------------------------

# Path to this file. Set only when the orchestrator must read a machine
# configuration from somewhere other than runner/.env, as the frontend does.
# EXPO_FAST_ENV_FILE="../runner/.env"
