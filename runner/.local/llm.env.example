# Copy to llm.env and fill in. Only claude-isolated sources this file, so nothing
# here reaches the developer's own shell, Claude Code config, or Keychain.
#
# This file holds the endpoint and its credentials, and nothing else.
# Models, effort, context windows, and per-role timeouts live in
# config/execution.json; machine paths and devices live in runner/.env.
#
# claude-isolated refuses to start when this file sets a variable that
# config/execution.json owns (CLAUDE_CODE_MAX_CONTEXT_TOKENS,
# CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING). Because llm.env is sourced last, a
# stale copy here would silently override the per-role value with nothing
# reporting it, so the launcher rejects it instead.

export ANTHROPIC_BASE_URL="https://your-gateway.example.com"

# Bearer form. The x-api-key form below also works, but ANTHROPIC_API_KEY makes
# Claude Code ask for interactive approval on first use, which hangs the
# detached tmux run that start-livetest.sh creates.
export ANTHROPIC_AUTH_TOKEN="sk-..."
# export ANTHROPIC_API_KEY="sk-..."

# Keep non-essential traffic off Anthropic endpoints when using a third party.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
